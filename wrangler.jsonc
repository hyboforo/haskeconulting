{
  // Cloudflare Workers config. `npm run deploy` builds ./out and uploads it.
  "name": "haskeconsulting",
  "compatibility_date": "2026-09-01",
  // Only the contact form's /api/enquiry runs code (worker/index.js); every other address is a static file.
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }

  // Contact form email. Until these are set, the form offers WhatsApp and email with the message written in.
  // Turn on Email Routing for haskeconsulting.com and verify the receiving inbox first (README, "Contact form"),
  // then put a comma after the "assets" block above and uncomment these two lines with the real inbox:
  //
  // "send_email": [{ "name": "ENQUIRY_EMAIL", "destination_address": "inbox@example.com" }],
  // "vars": { "ENQUIRY_FROM": "website@haskeconsulting.com", "ENQUIRY_TO": "inbox@example.com" }
}
